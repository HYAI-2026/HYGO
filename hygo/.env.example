# 관리자 암호 (기본값: hyai0926)
HYGO_ADMIN_PASSWORD=hyai0926

# 서버 포트 (기본값: 4000)
HYGO_PORT=4000

# 새 미션 인증이 제출될 때마다 알림을 보낼 디스코드/슬랙 인커밍 웹훅 URL (선택 사항, 비워두면 알림 안 보냄)
HYGO_WEBHOOK_URL=

# Upstash Redis (REST) — 지정하면 여기에 데이터를 저장해서 Render가 슬립/재시작/재배포돼도 데이터가 안 사라짐.
# upstash.com에서 무료 Redis 데이터베이스를 만들면 REST URL과 토큰을 받을 수 있어요.
# 비워두면 로컬 파일(data/hygo-data.json)에 저장하는데, 이 경우 Render 무료 플랜에서는 재시작 시 초기화돼요.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
