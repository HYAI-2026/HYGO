# 관리자 암호 (기본값: hyai0926)
HYGO_ADMIN_PASSWORD=hyai0926

# 서버 포트 (기본값: 4000)
HYGO_PORT=4000

# 새 미션 인증이 제출될 때마다 알림을 보낼 디스코드/슬랙 인커밍 웹훅 URL (선택 사항, 비워두면 알림 안 보냄)
HYGO_WEBHOOK_URL=

# Upstash Redis (REST) — 지정하면 여기에 데이터를 저장해서 Render가 슬립/재시작/재배포돼도 데이터가 안 사라짐.
# upstash.com에서 무료 Redis 데이터베이스를 만들면 REST URL과 토큰을 받을 수 있어요.
# 비워두면 로컬 파일(data/hygo-data.json)에 저장하는데, 이 경우 Render 무료 플랜에서는 재시작 시 초기화돼요.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 카카오 로그인 — Kakao Developers(developers.kakao.com)에서 앱을 만들고
# "카카오 로그인" 활성화 후 REST API 키를 발급받아 넣으세요.
# Redirect URI는 Kakao Developers 콘솔에도 똑같이 등록해야 해요: {배포주소}/api/hygo/auth/kakao/callback
KAKAO_REST_API_KEY=
# Client Secret을 켰다면 같이 넣어주세요 (안 켰으면 비워둬도 됨)
KAKAO_CLIENT_SECRET=
# 비워두면 요청받은 주소로 자동 계산됨 (배포 후 도메인이 고정되면 명시하는 걸 추천)
KAKAO_REDIRECT_URI=

# 로그인 쿠키 서명용 비밀값 — 아무 임의의 긴 문자열로 바꿔서 사용하세요 (외부에 노출되면 안 됨)
COOKIE_SECRET=
